generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id          String       @id @default(cuid())
  answer      String // The actual topic
  date        DateTime     @unique // The date this topic is featured
  type        String // e.g., "Public Figure", "Movie", "Book", etc.
  hints       Hint[]
  submissions Submission[]

  @@index([date]) // Used to quickly find topics by date
}

model Hint {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content String // The hint content
  type    String // Category, Emoji, Quote, Trivia, Definition
  order   Int // Order of the hint (1-5)

  @@unique([topicId, order]) // Ensure unique order per topic
  @@index([topicId]) // For efficient lookups by topic
}

model Submission {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts  Int // Number of attempts made
  guesses   String[] // List of guesses made, e.g., ["Einstein", "Newton"]
  duration  Int // Time taken in seconds to guess correctly
  success   Boolean  @default(false) // Whether the player guessed correctly
  createdAt DateTime @default(now())

  @@index([topicId]) // For efficient lookups by topic
}
